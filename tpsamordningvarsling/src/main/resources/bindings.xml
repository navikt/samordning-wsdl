<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<jaxb:bindings
        xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb"
        xmlns:xs="http://www.w3.org/2001/XMLSchema"
        xmlns:xjc="http://java.sun.com/xml/ns/jaxb/xjc"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        https://jakarta.ee/xml/ns/jaxb https://jakarta.ee/xml/ns/jaxb/bindingschema_3_0.xsd
        http://java.sun.com/xml/ns/jaxb/xjc http://java.sun.com/xml/ns/jaxb/xjc.xsd"
        jaxb:extensionBindingPrefixes="xjc"
        version="3.0">

    <jaxb:globalBindings>
        <xjc:javaType
                adapter="no.nav.samordning.wsdl.tpsamordningvarsling.LocalDateAdapter"
                name="java.time.LocalDate"
                xmlType="xs:date" />
    </jaxb:globalBindings>
</jaxb:bindings>
